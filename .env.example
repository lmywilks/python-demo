# Gateway mode:
#   mock    deterministic local responses for tests and demos
#   litellm real provider calls through LiteLLM
LLM_GATEWAY=mock

# Model name. Mock mode ignores provider credentials.
# LiteLLM examples:
#   openai/gpt-5-mini
#   anthropic/claude-sonnet-4-5
#   azure/my-deployment
#   openrouter/openai/gpt-5-mini
LLM_MODEL=mock/testing-agent

# Provider credentials. Only needed when LLM_GATEWAY=litellm.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Optional gateway/proxy endpoint. Only needed when LLM_GATEWAY=litellm.
LLM_API_BASE=

# Workflow settings.
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
